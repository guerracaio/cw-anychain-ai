# Paths are relative to the repository root.
APP_CONFIG=config/ethereum-mainnet.example.yaml
# RPC is optional: without it, only Blockscout is used and the limitation is reported.
# Public example (recent state only): https://ethereum-rpc.publicnode.com
RPC_URL=
# Optional GitHub token (read-only public access is enough). Without it, GitHub allows
# 60 API requests per hour, which a few repository-grounded analyses can exhaust.
GITHUB_TOKEN=
# LLM: optional. Without it, the analysis returns evidence only. Providers: openai, gemini.
# Examples (check current model ids and prices):
#   LLM_PROVIDER=openai  LLM_MODEL=gpt-5-mini        prices 0.25 / 2.00
#   LLM_PROVIDER=gemini  LLM_MODEL=gemini-3.8-flash  prices 0.75 / 3.75
LLM_PROVIDER=
LLM_MODEL=
# Optional: reasoning effort (minimal|low|medium|high|none; default low) and prices in USD per
# 1M tokens, used only for the estimated cost shown in logs and responses.
LLM_THINKING_LEVEL=
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: required to change settings from the UI when set. Without it, settings can only
# be changed from this machine (loopback). Set it whenever the UI is reachable by others.
ADMIN_TOKEN=
